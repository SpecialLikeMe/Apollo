namespace sys {
    str empty() {
        return "";
    }

    str space() {
        return " ";
    }

    str newline() {
        return "\n";
    }

    str tab() {
        return "\t";
    }

    str brackets(str value) {
        return "[${value}]";
    }

    str parens(str value) {
        return "(${value})";
    }

    str join_space(str left, str right) {
        return "${left} ${right}";
    }

    str join_colon(str left, str right) {
        return "${left}: ${right}";
    }

    str pair_i32(i32 left, i32 right) {
        return "${left}, ${right}";
    }

    str label_i32(str label, i32 value) {
        return "${label}: ${value}";
    }

    str status(str label, str value) {
        return "${label}: ${value}";
    }
}

