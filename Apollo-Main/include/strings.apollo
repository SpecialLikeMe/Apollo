namespace sys {
    str empty() {
        return "";
    }

    str space() {
        return " ";
    }

    str newline() {
        return "\n";
    }

    str tab() {
        return "\t";
    }

    str brackets(nconst str& value) {
        return "[${value}]";
    }

    str parens(nconst str& value) {
        return "(${value})";
    }

    str join_space(nconst str& left, nconst str& right) {
        return "${left} ${right}";
    }

    str join_colon(nconst str& left, nconst str& right) {
        return "${left}: ${right}";
    }

    str pair_i32(i32 left, i32 right) {
        return "${left}, ${right}";
    }

    str label_i32(nconst str& label, i32 value) {
        return "${label}: ${value}";
    }

    str status(nconst str& label, nconst str& value) {
        return "${label}: ${value}";
    }

    i32 str_len(nconst str& value) {
        return sys__native_str_len(value);
    }

    str str_concat(nconst str& left, nconst str& right) {
        return sys__native_str_concat(left, right);
    }

    str str_trim(nconst str& value) {
        return sys__native_str_trim(value);
    }

    str str_trim_start(nconst str& value) {
        return sys__native_str_trim_start(value);
    }

    str str_trim_end(nconst str& value) {
        return sys__native_str_trim_end(value);
    }

    str str_lowercase(nconst str& value) {
        return sys__native_str_lowercase(value);
    }

    str str_uppercase(nconst str& value) {
        return sys__native_str_uppercase(value);
    }

    str str_titlecase(nconst str& value) {
        return sys__native_str_titlecase(value);
    }

    i32 str_contains(nconst str& value, nconst str& sub) {
        return sys__native_str_contains(value, sub);
    }

    i32 str_starts_with(nconst str& value, nconst str& prefix) {
        return sys__native_str_starts_with(value, prefix);
    }

    i32 str_ends_with(nconst str& value, nconst str& suffix) {
        return sys__native_str_ends_with(value, suffix);
    }

    i32 str_find(nconst str& value, nconst str& sub) {
        return sys__native_str_find(value, sub);
    }

    i32 str_rfind(nconst str& value, nconst str& sub) {
        return sys__native_str_rfind(value, sub);
    }

    str str_replace(nconst str& value, nconst str& old_text, nconst str& new_text) {
        return sys__native_str_replace(value, old_text, new_text);
    }

    str str_replace_n(nconst str& value, nconst str& old_text, nconst str& new_text, i32 count) {
        return sys__native_str_replace_n(value, old_text, new_text, count);
    }

    str str_reverse(nconst str& value) {
        return sys__native_str_reverse(value);
    }

    str str_repeat(nconst str& value, i32 count) {
        return sys__native_str_repeat(value, count);
    }

    str str_pad_left(nconst str& value, i32 target_len, nconst str& fill) {
        return sys__native_str_pad_left(value, target_len, fill);
    }

    str str_pad_right(nconst str& value, i32 target_len, nconst str& fill) {
        return sys__native_str_pad_right(value, target_len, fill);
    }

    str str_substring(nconst str& value, i32 start, i32 len) {
        return sys__native_str_substring(value, start, len);
    }

    i32 str_cmp(nconst str& left, nconst str& right) {
        return sys__native_str_cmp(left, right);
    }

    i32 str_casecmp(nconst str& left, nconst str& right) {
        return sys__native_str_casecmp(left, right);
    }

    vector str_split(nconst str& value, nconst str& delimiter) {
        return sys__native_str_split(value, delimiter);
    }

    vector str_split_n(nconst str& value, nconst str& delimiter, i32 max_parts) {
        return sys__native_str_split_n(value, delimiter, max_parts);
    }

    vector str_split_lines(nconst str& value) {
        return sys__native_str_split_lines(value);
    }

    long parse_int(nconst str& value, i32 base) {
        return sys__native_parse_int(value, base);
    }

    i32 parse_bool(nconst str& value) {
        return sys__native_parse_bool(value);
    }

    f64 parse_float(nconst str& value) {
        return sys__native_parse_float(value);
    }

    i32 is_alpha(nconst str& value) {
        return sys__native_is_alpha(value);
    }

    i32 is_digit(nconst str& value) {
        return sys__native_is_digit(value);
    }

    i32 is_alnum(nconst str& value) {
        return sys__native_is_alnum(value);
    }

    i32 is_whitespace(nconst str& value) {
        return sys__native_is_whitespace(value);
    }

    i32 is_control(nconst str& value) {
        return sys__native_is_control(value);
    }

    i32 is_punctuation(nconst str& value) {
        return sys__native_is_punctuation(value);
    }

    i32 is_graph(nconst str& value) {
        return sys__native_is_graph(value);
    }

    i32 is_print(nconst str& value) {
        return sys__native_is_print(value);
    }

    i32 is_hex_digit(nconst str& value) {
        return sys__native_is_hex_digit(value);
    }

    i32 is_ascii(nconst str& value) {
        return sys__native_is_ascii(value);
    }
}

