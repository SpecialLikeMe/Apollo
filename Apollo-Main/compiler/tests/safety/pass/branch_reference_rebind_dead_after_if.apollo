// This should compile: divergent branch rebinds are allowed when the merged alias is dead afterward.

int main() {
    nconst i32 first = 1;
    nconst i32 second = 2;
    i32 branch = 0;
    nconst i32& alias = &nconst first;
    if (branch) {
        alias = &nconst second;
    } else {
        sys.println(alias);
    }
    first = 3;
    second = 4;
    return first + second;
}