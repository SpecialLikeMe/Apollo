extern std prelude;

tuple<i32, bool> wrap_pair(i32 left, i32 right) {
    return {left + right, left < right};
}

option<i32> parse_value(bool flag) {
    if (flag) {
        return nominal(7);
    }
    return cerr("bad");
}

option<str, cerr> read_label(bool flag) {
    if (flag) {
        return nominal("ready");
    }
    return terminalcerr("missing");
}

i32 main() {
    tuple<i32, bool> pair = wrap_pair(2, 5);
    option<i32> good = parse_value(true);
    option<i32> bad = parse_value(false);
    option<str, cerr> missing = read_label(false);

    if (pair[0] != 7) {
        return 1;
    }
    if (pair[1] == false) {
        return 2;
    }
    if (sys.is_nominal(good) == 0) {
        return 3;
    }
    if (sys.unwrap_i32(good) != 7) {
        return 4;
    }
    if (sys.is_cerr(bad) == 0) {
        return 5;
    }
    if (sys.error_message(bad) != "bad") {
        return 6;
    }
    if (sys.is_terminal(missing) == 0) {
        return 7;
    }
    if (sys.error_message(missing) != "missing") {
        return 8;
    }
    return 0;
}
