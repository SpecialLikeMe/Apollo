extern iostream;

class et {
    public void hello() {
        sys.stdout("Hello, world");
        return;
    }
}

int main() {
    @unsafe {
        std -hres {
            et* ptr = new et();
            ptr->hello();
            delete ptr;
        }
    }
    return 0;
}

class run * private et {
    public void please() {
        hello();
        return;
    }
}