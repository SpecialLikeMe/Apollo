@apollo.print.fmt = private unnamed_addr constant [4 x i8] c"%s\0A\00"
@apollo.str.literal = private unnamed_addr constant [6 x i8] c"hello\00"
@apollo.str.literal.1 = private unnamed_addr constant [6 x i8] c"world\00"
@apollo.print.fmt.2 = private unnamed_addr constant [4 x i8] c"%s\0A\00"

define void @inspect(ptr %value) {
entry:
  %value1 = alloca ptr, align 8
  store ptr %value, ptr %value1, align 8
  %0 = load ptr, ptr %value1, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt, ptr %0)
  ret void
}

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %alias = alloca ptr, align 8
  %value = alloca ptr, align 8
  store ptr @apollo.str.literal, ptr %value, align 8
  store ptr %value, ptr %alias, align 8
  %0 = load ptr, ptr %alias, align 8
  call void @inspect(ptr %0)
  store ptr @apollo.str.literal.1, ptr %value, align 8
  %1 = load ptr, ptr %value, align 8
  %2 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt.2, ptr %1)
  ret i32 0
}

