#ifndef __APO_HASH_SUPPORT
#define __APO_HASH_SUPPORT
template <typename T>
inline void __apo_hash_combine(std::size_t& seed, const T& value) {
    seed ^= value + 0x9e3779b97f4a7c15ULL + (seed << 6) + (seed >> 2);
}
template <typename T>
struct __apo_hash {
    std::size_t operator()(const T& value) const { return std::hash<T>{}(value); }
};
template <typename T>
struct __apo_hash<std::vector<T>> {
    std::size_t operator()(const std::vector<T>& values) const {
        std::size_t seed = 0;
        for (const auto& value : values) {
            __apo_hash_combine(seed, __apo_hash<T>{}(value));
        }
        return seed;
    }
};
template <typename K, typename V, typename H, typename E, typename A>
struct __apo_hash<std::unordered_map<K, V, H, E, A>> {
    std::size_t operator()(const std::unordered_map<K, V, H, E, A>& values) const {
        std::size_t seed = 0;
        for (const auto& entry : values) {
            std::size_t entrySeed = __apo_hash<K>{}(entry.first);
            __apo_hash_combine(entrySeed, __apo_hash<V>{}(entry.second));
            seed ^= entrySeed + 0x9e3779b97f4a7c15ULL;
        }
        return seed;
    }
};
#endif

#ifndef __APO_TEMPLATE_LITERAL_SUPPORT
#define __APO_TEMPLATE_LITERAL_SUPPORT
template <typename T>
static std::string __apo_to_string(const T& value) {
    std::ostringstream stream;
    stream << value;
    return stream.str();
}
static std::string __apo_to_string(const std::string& value) { return value; }
static std::string __apo_to_string(const char* value) { return value != nullptr ? std::string(value) : std::string(); }
static std::string __apo_to_string(bool value) { return value ? "true" : "false"; }
#endif

#ifndef __APO_ISC_RUNTIME_SUPPORT
#define __APO_ISC_RUNTIME_SUPPORT
struct __apo_isc {
    bool ok;
    bool terminal;
    std::string message;
    static __apo_isc success() {
        return {true, false, ""};
    }
    static __apo_isc error(const std::string& message, bool terminal = false) {
        return {false, terminal, message};
    }
    bool failed() const {
        return !ok;
    }
};
#endif

#ifndef __APO_FILE_RUNTIME_SUPPORT
#define __APO_FILE_RUNTIME_SUPPORT
struct __apo_file {
    std::shared_ptr<std::fstream> stream;
    __apo_file() : stream(std::make_shared<std::fstream>()) {}
    static __apo_file open(const std::string& path, const std::string& mode = "r") {
        __apo_file file;
        std::ios::openmode flags = static_cast<std::ios::openmode>(0);
        if (mode.find('a') != std::string::npos) {
            flags |= std::ios::out | std::ios::app;
        } else if (mode.find('w') != std::string::npos) {
            flags |= std::ios::out | std::ios::trunc;
        } else {
            flags |= std::ios::in;
        }
        if (mode.find('+') != std::string::npos) {
            flags |= std::ios::in | std::ios::out;
        }
        if (mode.find('b') != std::string::npos) {
            flags |= std::ios::binary;
        }
        file.stream->open(path, flags);
        return file;
    }
    void write(const std::string& value) const {
        if (stream && stream->is_open()) {
            (*stream) << value;
        }
    }
    std::string read() const {
        if (!stream || !stream->is_open()) {
            return "";
        }
        std::ostringstream buffer;
        buffer << stream->rdbuf();
        return buffer.str();
    }
    void close() const {
        if (stream && stream->is_open()) {
            stream->close();
        }
    }
};
#endif

struct __apo_gc_tracer {};
template <typename T> inline void __apo_gc_trace_value(__apo_gc_tracer&, const T&) {}
template <typename T> struct __apo_soa_adapter;
template <typename T> struct __apo_allocator_traits { static constexpr bool is_memstruct = false; };

__apo_isc write_log() {
    const __apo_file handle = open("output/status_file.txt", "w");
    handle.write("hello");
    handle.close();
    return terminalcerr("disk full");
}

__apo_isc read_log() {
    const __apo_file handle = open("output/status_file.txt");
    const std::string contents = handle.read();
    handle.close();
    std::cout << (contents) << std::endl;
    return __apo_isc::success();
}

__apo_isc run() {
    const __apo_isc status = write_log();
    if (status.failed()) {
        const std::string& err = status.message;
        std::cout << (err) << std::endl;
        if (status.terminal) return status;
    }
    return read_log();
}

int main() {
    const __apo_isc result = run();
    if (result.failed()) {
        const std::string& err = result.message;
        std::cout << (err) << std::endl;
        if (result.terminal) throw std::runtime_error(result.message);
    }
    return 0;
}


