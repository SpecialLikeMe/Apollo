source_filename = "C:/Users/devon/Apollo/Apollo-Main/compiler/tests/grammar/pass/src_callable_surface.apollo"

@apollo.str.literal = private unnamed_addr constant [6 x i8] c"hello\00"
@apollo.print.fmt = private unnamed_addr constant [4 x i8] c"%s\0A\00"
@apollo.str.literal.1 = private unnamed_addr constant [6 x i8] c"world\00"
@apollo.print.fmt.2 = private unnamed_addr constant [4 x i8] c"%s\0A\00"

define i32 @main() {
entry:
  %total = alloca i32, align 4
  %echoed = alloca ptr, align 8
  call void @main.src.greet()
  %0 = call ptr @main.src.echo(ptr @apollo.str.literal.1)
  store ptr %0, ptr %echoed, align 8
  %1 = call i32 @main.src.count(i32 4)
  store i32 %1, ptr %total, align 4
  %2 = load i32, ptr %total, align 4
  %3 = add i32 %2, 1
  store i32 %3, ptr %total, align 4
  %4 = load ptr, ptr %echoed, align 8
  %5 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt.2, ptr %4)
  %6 = load i32, ptr %total, align 4
  ret i32 %6
}

define internal void @main.src.greet() {
entry:
  %0 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt, ptr @apollo.str.literal)
  ret void
}

declare i32 @printf(ptr, ...)

define internal ptr @main.src.echo(ptr %value) {
entry:
  %value1 = alloca ptr, align 8
  store ptr %value, ptr %value1, align 8
  %0 = load ptr, ptr %value1, align 8
  ret ptr %0
}

define internal i32 @main.src.count(i32 %value) {
entry:
  %value1 = alloca i32, align 4
  store i32 %value, ptr %value1, align 4
  %0 = load i32, ptr %value1, align 4
  %1 = add i32 %0, 1
  ret i32 %1
}

