define i32 @decorate(i32 %value) {
entry:
  %toggled = alloca i32, align 4
  %mixed = alloca i32, align 4
  %shifted = alloca i32, align 4
  %value1 = alloca i32, align 4
  store i32 %value, ptr %value1, align 4
  %0 = load i32, ptr %value1, align 4
  %1 = shl i32 %0, 1
  store i32 %1, ptr %shifted, align 4
  %2 = load i32, ptr %shifted, align 4
  %3 = or i32 %2, 3
  store i32 %3, ptr %mixed, align 4
  %4 = load i32, ptr %mixed, align 4
  %5 = xor i32 %4, 2
  store i32 %5, ptr %toggled, align 4
  %6 = load i32, ptr %toggled, align 4
  %7 = and i32 %6, 7
  ret i32 %7
}

define i32 @main() {
entry:
  %SharedState.object = alloca %apollo.aggregate.SharedState, align 8
  %state = alloca ptr, align 8
  store %apollo.aggregate.SharedState zeroinitializer, ptr %SharedState.object, align 4
  store ptr %SharedState.object, ptr %state, align 8
  %0 = call i32 @decorate(i32 4)
  ret i32 %0
}

