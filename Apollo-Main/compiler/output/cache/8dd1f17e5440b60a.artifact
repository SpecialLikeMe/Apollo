; ModuleID = 'branch_shared_borrow_split'
source_filename = "C:/Users/devon/Apollo/Apollo-Main/compiler/tests/safety/pass/branch_shared_borrow_split.apollo"

@apollo.print.fmt = private unnamed_addr constant [4 x i8] c"%s\0A\00"

define void @inspect(ptr %value) {
entry:
  %value1 = alloca ptr, align 8
  store ptr %value, ptr %value1, align 8
  %0 = load ptr, ptr %value1, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt, ptr %0)
  ret void
}

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %branch = alloca i32, align 4
  %alias = alloca ptr, align 8
  %value = alloca i32, align 4
  store i32 1, ptr %value, align 4
  store ptr %value, ptr %alias, align 8
  store i32 0, ptr %branch, align 4
  %0 = load i32, ptr %branch, align 4
  br i1 false, label %if.then, label %if.else

if.then:                                          ; preds = %entry
  %1 = load ptr, ptr %alias, align 8
  call void @inspect(ptr %1)
  br label %if.end

if.else:                                          ; preds = %entry
  store i32 2, ptr %value, align 4
  br label %if.end

if.end:                                           ; preds = %if.else, %if.then
  %2 = load i32, ptr %value, align 4
  ret i32 %2
}

