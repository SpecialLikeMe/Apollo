@apollo.str.literal = private unnamed_addr constant [13 x i8] c"Hello, world\00"
@apollo.print.fmt = private unnamed_addr constant [3 x i8] c"%s\00"

define internal void @"apollo$run$please"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  ret void
}

define internal void @"apollo$et$hello"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt, ptr @apollo.str.literal)
  ret void
}

declare i32 @printf(ptr, ...)

define i32 @main() {
entry:
  %i = alloca i32, align 4
  store i32 0, ptr %i, align 4
  ret i32 0
}

