define internal void @"apollo$Box$ping"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  ret void
}

define i32 @main() {
entry:
  %Box.object1 = alloca %apollo.aggregate.Box, align 8
  %inner = alloca ptr, align 8
  %Box.object = alloca %apollo.aggregate.Box, align 8
  %value = alloca ptr, align 8
  store %apollo.aggregate.Box zeroinitializer, ptr %Box.object, align 1
  store ptr %Box.object, ptr %value, align 8
  store %apollo.aggregate.Box zeroinitializer, ptr %Box.object1, align 1
  store ptr %Box.object1, ptr %inner, align 8
  %0 = load ptr, ptr %inner, align 8
  call void @"apollo$Box$ping"(ptr %0)
  %1 = load ptr, ptr %value, align 8
  call void @"apollo$Box$ping"(ptr %1)
  ret i32 0
}

