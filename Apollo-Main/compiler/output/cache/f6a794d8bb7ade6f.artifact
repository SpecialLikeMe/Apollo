; ModuleID = 'typedef_opstruct_scope_surface'
source_filename = "C:/Users/devon/Apollo/Apollo-Main/compiler/tests/grammar/pass/typedef_opstruct_scope_surface.apollo"

%apollo.aggregate.cool = type { i8 }

@apollo.template.str.literal = private unnamed_addr constant [29 x i8] c"sys.println(\22Hello, world\22);\00"

define i32 @main() {
entry:
  %i = alloca ptr, align 8
  %cool.object = alloca %apollo.aggregate.cool, align 8
  %mycool = alloca ptr, align 8
  store %apollo.aggregate.cool zeroinitializer, ptr %cool.object, align 1
  store ptr %cool.object, ptr %mycool, align 8
  store ptr @apollo.template.str.literal, ptr %i, align 8
  %0 = load ptr, ptr %i, align 8
  %1 = call i32 @apollo_execute_apollo_payload(ptr %0)
  ret i32 0
}

declare i32 @apollo_execute_apollo_payload(ptr)

!apollo.backend = !{!0}
