; ModuleID = 'branch_reference_rebind_dead_after_if'
source_filename = "C:/Users/devon/Apollo/Apollo-Main/compiler/tests/safety/pass/branch_reference_rebind_dead_after_if.apollo"

@apollo.print.fmt = private unnamed_addr constant [4 x i8] c"%s\0A\00"

define i32 @main() {
entry:
  %alias = alloca ptr, align 8
  %branch = alloca i32, align 4
  %second = alloca i32, align 4
  %first = alloca i32, align 4
  store i32 1, ptr %first, align 4
  store i32 2, ptr %second, align 4
  store i32 0, ptr %branch, align 4
  store ptr %first, ptr %alias, align 8
  %0 = load i32, ptr %branch, align 4
  br i1 false, label %if.then, label %if.else

if.then:                                          ; preds = %entry
  store ptr %second, ptr %alias, align 8
  br label %if.end

if.else:                                          ; preds = %entry
  %1 = load ptr, ptr %alias, align 8
  %2 = call i32 (ptr, ...) @printf(ptr @apollo.print.fmt, ptr %1)
  br label %if.end

if.end:                                           ; preds = %if.else, %if.then
  store i32 3, ptr %first, align 4
  store i32 4, ptr %second, align 4
  %3 = load i32, ptr %first, align 4
  %4 = load i32, ptr %second, align 4
  %5 = add i32 %3, %4
  ret i32 %5
}

declare i32 @printf(ptr, ...)

