; ModuleID = 'literal_shape_surface'
source_filename = "literal_shape_surface.apollo"
target triple = "x86_64-w64-windows-gnu"

define i1 @invert(i1 %value) {
entry:
  %value1 = alloca i1, align 1
  store i1 %value, ptr %value1, align 1
  %0 = load i1, ptr %value1, align 1
  br i1 %0, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  ret i1 false

if.end:                                           ; preds = %entry
  ret i1 true
}

define i32 @first_codepoint() {
entry:
  ret i32 97
}

define i8 @first_byte() {
entry:
  ret i8 97
}

define i64 @handle_id(i64 %value) {
entry:
  %value1 = alloca i64, align 8
  store i64 %value, ptr %value1, align 4
  %0 = load i64, ptr %value1, align 4
  ret i64 %0
}

define double @circle_ratio() {
entry:
  ret double 3.141590e+00
}

define ptr @none_value() {
entry:
  ret ptr null
}

define { i32, i1 } @literal_bundle() {
entry:
  ret { i32, i1 } { i32 122, i1 true }
}

define i32 @main() {
entry:
  %0 = call i1 @invert(i1 false)
  br i1 %0, label %if.then, label %if.end

if.then:                                          ; preds = %entry
  ret i32 1

if.end:                                           ; preds = %entry
  ret i32 0
}

