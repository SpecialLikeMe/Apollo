define i32 @main() {
entry:
  %secondary = alloca ptr, align 8
  %primary = alloca ptr, align 8
  %tlsf = alloca ptr, align 8
  %page = alloca ptr, align 8
  %scratch = alloca ptr, align 8
  %stack = alloca ptr, align 8
  %slab = alloca ptr, align 8
  %pool = alloca ptr, align 8
  %bump = alloca ptr, align 8
  %arena = alloca ptr, align 8
  %gpa = alloca ptr, align 8
  %default_alloc = alloca ptr, align 8
  %0 = call ptr @sys__alloc_default()
  store ptr %0, ptr %default_alloc, align 8
  %1 = call ptr @sys__alloc_gpa()
  store ptr %1, ptr %gpa, align 8
  %2 = call ptr @sys__alloc_arena()
  store ptr %2, ptr %arena, align 8
  %3 = call ptr @sys__alloc_bump()
  store ptr %3, ptr %bump, align 8
  %4 = call ptr @sys__alloc_pool()
  store ptr %4, ptr %pool, align 8
  %5 = call ptr @sys__alloc_slab()
  store ptr %5, ptr %slab, align 8
  %6 = call ptr @sys__alloc_stack()
  store ptr %6, ptr %stack, align 8
  %7 = call ptr @sys__alloc_scratch()
  store ptr %7, ptr %scratch, align 8
  %8 = call ptr @sys__alloc_page()
  store ptr %8, ptr %page, align 8
  %9 = call ptr @sys__alloc_tlsf()
  store ptr %9, ptr %tlsf, align 8
  store ptr null, ptr %primary, align 8
  store ptr null, ptr %secondary, align 8
  ret i32 0
}

