    std::cout << ("Hello, world!") << std::endl;
}

class apo_woeiru {
    friend void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_woeiru& value);
    friend struct __apo_soa_adapter<apo_woeiru>;
};

inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_woeiru& value) {
}

template <>
struct __apo_soa_adapter<apo_woeiru> {
    struct storage {
        std::size_t size = 0;
    };

    static void push(storage& storage, const apo_woeiru& value) {
        ++storage.size;
    }

    static apo_woeiru load(const storage& storage, std::size_t index) {
        apo_woeiru value{};
        return value;
    }

    static void store(storage& storage, std::size_t index, const apo_woeiru& value) {
        (void)storage;
        (void)index;
        (void)value;
    }

    static std::size_t size(const storage& storage) {
        return storage.size;
    }
};

template <typename T>
class apo_id {
public:
    T alloc() {
        const T i;
        return i;
    }

    public:
    void __apo_gc_trace_fields(__apo_gc_tracer& tracer) const {
    }
};

template <typename T>
inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_id<T>& value) {
    value.__apo_gc_trace_fields(tracer);
}

