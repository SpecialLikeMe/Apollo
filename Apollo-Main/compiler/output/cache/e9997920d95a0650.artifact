class apo_mycls {
    friend void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_mycls& value);
    friend struct __apo_soa_adapter<apo_mycls>;
public:
    static void bark() {
        std::cout << ("static") << std::endl;
        return;
    }

};

inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_mycls& value) {
}

template <>
struct __apo_soa_adapter<apo_mycls> {
    struct storage {
        std::size_t size = 0;
    };

    static void push(storage& storage, const apo_mycls& value) {
        ++storage.size;
    }

    static apo_mycls load(const storage& storage, std::size_t index) {
        apo_mycls value{};
        return value;
    }

    static void store(storage& storage, std::size_t index, const apo_mycls& value) {
        (void)storage;
        (void)index;
        (void)value;
    }

    static std::size_t size(const storage& storage) {
        return storage.size;
    }
};


