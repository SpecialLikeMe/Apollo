%apollo.aggregate.Counter = type { i32 }

define internal i32 @"apollo$Counter$bump"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  %1 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %0, i32 0, i32 0
  %2 = load i32, ptr %1, align 4
  %3 = add i32 %2, 1
  ret i32 %3
}

define i32 @main() {
entry:
  %Counter.object2 = alloca %apollo.aggregate.Counter, align 8
  %direct = alloca ptr, align 8
  %Counter.object1 = alloca %apollo.aggregate.Counter, align 8
  %pack = alloca ptr, align 8
  %total = alloca i32, align 4
  %counter = alloca ptr, align 8
  %Counter.object = alloca %apollo.aggregate.Counter, align 8
  store %apollo.aggregate.Counter zeroinitializer, ptr %Counter.object, align 4
  store ptr %Counter.object, ptr %counter, align 8
  %0 = load ptr, ptr %counter, align 8
  %1 = call i32 @"apollo$Counter$bump"(ptr %0)
  store i32 4, ptr %total, align 4
  %2 = load i32, ptr %total, align 4
  %3 = add i32 %2, 1
  store i32 %3, ptr %total, align 4
  store ptr null, ptr %pack, align 8
  store %apollo.aggregate.Counter zeroinitializer, ptr %Counter.object1, align 4
  store ptr %Counter.object1, ptr %pack, align 8
  %4 = load ptr, ptr %pack, align 8
  %5 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %4, i32 0, i32 0
  %6 = load i32, ptr %5, align 4
  store %apollo.aggregate.Counter zeroinitializer, ptr %Counter.object2, align 4
  store ptr %Counter.object2, ptr %direct, align 8
  %7 = load ptr, ptr %direct, align 8
  %8 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %7, i32 0, i32 0
  %9 = load i32, ptr %8, align 4
  %10 = load i32, ptr %total, align 4
  %11 = load i32, ptr %total, align 4
  ret i32 0
}

