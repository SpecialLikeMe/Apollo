define i32 @loadBorrow(ptr %source) {
entry:
  %borrow = alloca ptr, align 8
  %source1 = alloca ptr, align 8
  store ptr %source, ptr %source1, align 8
  store ptr %source1, ptr %borrow, align 8
  %0 = load ptr, ptr %borrow, align 8
  %1 = load ptr, ptr %borrow, align 8
  ret i32 0
}

define i32 @increment(i32 %value) {
entry:
  %value1 = alloca i32, align 4
  store i32 %value, ptr %value1, align 4
  %0 = load i32, ptr %value1, align 4
  %1 = add i32 %0, 1
  store i32 %1, ptr %value1, align 4
  %2 = load i32, ptr %value1, align 4
  ret i32 %2
}

define i32 @main() {
entry:
  %value = alloca i32, align 4
  store i32 1, ptr %value, align 4
  %0 = load i32, ptr %value, align 4
  %1 = load i32, ptr %value, align 4
  %2 = call i32 @increment(i32 %1)
  store i32 %2, ptr %value, align 4
  %3 = load i32, ptr %value, align 4
  ret i32 %3
}

