#ifndef __APO_HASH_SUPPORT
#define __APO_HASH_SUPPORT
template <typename T>
inline void __apo_hash_combine(std::size_t& seed, const T& value) {
    seed ^= value + 0x9e3779b97f4a7c15ULL + (seed << 6) + (seed >> 2);
}
template <typename T>
struct __apo_hash {
    std::size_t operator()(const T& value) const { return std::hash<T>{}(value); }
};
template <typename T>
struct __apo_hash<std::vector<T>> {
    std::size_t operator()(const std::vector<T>& values) const {
        std::size_t seed = 0;
        for (const auto& value : values) {
            __apo_hash_combine(seed, __apo_hash<T>{}(value));
        }
        return seed;
    }
};
template <typename K, typename V, typename H, typename E, typename A>
struct __apo_hash<std::unordered_map<K, V, H, E, A>> {
    std::size_t operator()(const std::unordered_map<K, V, H, E, A>& values) const {
        std::size_t seed = 0;
        for (const auto& entry : values) {
            std::size_t entrySeed = __apo_hash<K>{}(entry.first);
            __apo_hash_combine(entrySeed, __apo_hash<V>{}(entry.second));
            seed ^= entrySeed + 0x9e3779b97f4a7c15ULL;
        }
        return seed;
    }
};
#endif

#ifndef __APO_TEMPLATE_LITERAL_SUPPORT
#define __APO_TEMPLATE_LITERAL_SUPPORT
template <typename T>
static std::string __apo_to_string(const T& value) {
    std::ostringstream stream;
    stream << value;
    return stream.str();
}
static std::string __apo_to_string(const std::string& value) { return value; }
static std::string __apo_to_string(const char* value) { return value != nullptr ? std::string(value) : std::string(); }
static std::string __apo_to_string(bool value) { return value ? "true" : "false"; }
#endif

#include "runtime_support/apo_soa_runtime.hpp"
struct __apo_gc_tracer {};
template <typename T>
inline void __apo_gc_trace_value(__apo_gc_tracer&, const T&) {}
template <typename T>
class apo_Box;
class apo_Speaker;
class apo_Walker;
struct apo_Pair;
class apo_Animal;
class apo_Dog;

extern const std::int32_t globalCounter;

using namespace std;

class apo_Speaker {
    public:
        virtual ~apo_Speaker() = default;
        virtual void speak() = 0;
};

class apo_Walker {
    public:
        virtual ~apo_Walker() = default;
        virtual void walk() = 0;
};

template <typename T>
class apo_Box {
public:
    T fetch(const T value) {
        return value;
    }

    public:
    void __apo_gc_trace_fields(__apo_gc_tracer& tracer) const {
    }
};

template <typename T>
inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Box<T>& value) {
    value.__apo_gc_trace_fields(tracer);
}

struct apo_Pair {
    friend void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Pair& value);
    friend struct __apo_soa_adapter<apo_Pair>;
    std::int32_t left;
    std::int32_t right;
    int sum() {
        return left + right;
    }

};

inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Pair& value) {
    __apo_gc_trace_value(tracer, value.left);
    __apo_gc_trace_value(tracer, value.right);
}

template <>
struct __apo_soa_adapter<apo_Pair> {
    struct storage {
        std::vector<std::int32_t> left;
        std::vector<std::int32_t> right;
    };

    static void push(storage& storage, const apo_Pair& value) {
        storage.left.push_back(value.left);
        storage.right.push_back(value.right);
    }

    static apo_Pair load(const storage& storage, std::size_t index) {
        apo_Pair value{};
        value.left = storage.left[index];
        value.right = storage.right[index];
        return value;
    }

    static void store(storage& storage, std::size_t index, const apo_Pair& value) {
        storage.left[index] = value.left;
        storage.right[index] = value.right;
    }

    static std::size_t size(const storage& storage) {
        return storage.left.size();
    }
};

class apo_Animal : public apo_Speaker, public apo_Walker {
    friend void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Animal& value);
public:
    std::int32_t value;
    virtual void speak() {
        std::cout<<"animal"<<std::endl;
        return;
    }

    virtual void walk() {
        std::cout<<"walk"<<std::endl;
        return;
    }

};

inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Animal& value) {
    __apo_gc_trace_value(tracer, value.value);
}

class apo_Dog : public apo_Animal {
    friend void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Dog& value);
public:
    static void tag() {
        std::cout<<"dog-tag"<<std::endl;
        return;
    }

    void speak() override {
        std::cout<<"dog"<<std::endl;
        return;
    }

    void walk() override {
        std::cout<<"dog-walk"<<std::endl;
        return;
    }

};

inline void __apo_gc_trace_value(__apo_gc_tracer& tracer, const apo_Dog& value) {
}

static inline void announce(const std::string message) {
    std::cout<<message<<std::endl;
}

const std::int32_t plainGlobal = 2;
int plusOne(int value) {
    if (value < 10) {
        value = value + 1;
    }
    else {
        value = value - 1;
    }
    return value;
}

std::string& keep(const std::string& value) {
    return value;
}

void ping() {
    return;
}

int main() {
    apo_Box<int> box{};
    std::int32_t local = plusOne(globalCounter);
    const std::int32_t narrowed = (std::int32_t)local;
    const std::string templ = std::string("") + "hello template";
    std::function<int(int, int)> add = [&](const int left, const int right) -> int {
        return left + right;
    }
    ;
    std::function<int(int)> promote = [&](const int input) -> int {
        return input;
    }
    ;
    const std::int32_t sum = add(1, 2);
    const std::int32_t promoted = promote(sum);
    std::vector<std::string> names;
    names.push_back(templ);
    std::unordered_map<std::string, std::int32_t, __apo_hash<std::string>> scores;
    scores["dog"] = promoted;
    std::unordered_map<std::unordered_map<std::int32_t, std::string, __apo_hash<std::int32_t>>, std::unordered_map<std::string, std::int32_t, __apo_hash<std::string>>, __apo_hash<std::unordered_map<std::int32_t, std::string, __apo_hash<std::int32_t>>>> nested;
    nested[std::unordered_map<std::int32_t, std::string, __apo_hash<std::int32_t>>{{23, "hello"}}] = std::unordered_map<std::string, std::int32_t, __apo_hash<std::string>>{{"world", 9}};
    std::cout<<nested[std::unordered_map<std::int32_t, std::string, __apo_hash<std::int32_t>>{{23, "hello"}}]["world"]<<std::endl;
    std::any pack;
    pack = apo_Dog{};
    std::any_cast<apo_Dog&>(pack).speak();
    apo_Dog direct = apo_Dog{};
    direct.speak();
    apo_Dog::tag();
{
        apo_Dog* dogPtr = &direct;
        dogPtr->speak();
    }
    direct.value;
    const apo_Pair point = apo_Pair{};
    point.sum();
    std::string input;
    std::cin>>input;
{
        box.fetch(local);
        const std::int32_t scoped = local;
        std::cout<<scoped<<std::endl;
    }
    while (local < 3) {
        local = local + 1;
    }
    const std::string borrowed = keep(templ);
    announce(borrowed);
    std::cout<<scores["dog"];
    return plainGlobal + narrowed;
}

const std::int32_t globalCounter = 1;

