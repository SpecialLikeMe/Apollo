%apollo.aggregate.test = type { i32 }

define internal void @"apollo$test$__construct"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  %1 = getelementptr inbounds nuw %apollo.aggregate.test, ptr %0, i32 0, i32 0
  %2 = load ptr, ptr %indef1, align 8
  %3 = getelementptr inbounds nuw %apollo.aggregate.test, ptr %2, i32 0, i32 0
  store i32 0, ptr %3, align 4
  ret void
}

define i32 @main() {
entry:
  %test.object = alloca %apollo.aggregate.test, align 8
  %item = alloca ptr, align 8
  store %apollo.aggregate.test zeroinitializer, ptr %test.object, align 4
  call void @"apollo$test$__construct"(ptr %test.object)
  store ptr %test.object, ptr %item, align 8
  ret i32 0
}

