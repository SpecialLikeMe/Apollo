// apx bundle: C:/Users/devon/Apollo/Apollo-Main/compiler/build_test/proc_macro_validation/main.apollo
extern iostream;

attr vector<token> addhelper(vector<token> __tokenstream, nrc what) {
    nconst vector<token> output = __tokenstream;
    output.insert(0, quote {
        void generated_helper() {
            sys.println(what);
            return;
        }
    });
    return output;
}

derive vector<token> addafter(vector<token> __tokenstream, nrc what) {
    return quote {
        void generated_after() {
            sys.println(what);
            return;
        }
    };
}

#idio addhelper("before")
#derive addafter("after")
int main() {
    generated_helper();
    generated_after();
    return 0;
}


