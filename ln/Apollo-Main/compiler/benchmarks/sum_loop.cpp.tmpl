#include <cstdint>
#include <iostream>

int main() {
    std::int32_t total = 0;
    std::int32_t delta = 1;
    for (std::int32_t index = 0; index < __LIMIT__; ++index) {
        total += delta;
        delta += 1;
        if (delta > 9) {
            delta = 1;
        }
    }
    std::cout << total;
    return 0;
}