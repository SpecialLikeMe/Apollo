%apollo.aggregate.Counter = type { i32 }

define internal i32 @"apollo$Counter$fetch"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  %1 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %0, i32 0, i32 0
  %2 = load ptr, ptr %indef1, align 8
  %3 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %2, i32 0, i32 0
  %4 = load i32, ptr %3, align 4
  ret i32 %4
}

define internal i32 @"apollo$Counter$call"(ptr %indef) {
entry:
  %indef1 = alloca ptr, align 8
  store ptr %indef, ptr %indef1, align 8
  %0 = load ptr, ptr %indef1, align 8
  %1 = getelementptr inbounds nuw %apollo.aggregate.Counter, ptr %0, i32 0, i32 0
  %2 = load ptr, ptr %indef1, align 8
  %3 = call i32 @"apollo$Counter$fetch"(ptr %2)
  ret i32 %3
}

define i32 @main() {
entry:
  %Counter.object = alloca %apollo.aggregate.Counter, align 8
  %direct = alloca ptr, align 8
  store %apollo.aggregate.Counter zeroinitializer, ptr %Counter.object, align 4
  store ptr %Counter.object, ptr %direct, align 8
  %0 = load ptr, ptr %direct, align 8
  %1 = call i32 @"apollo$Counter$call"(ptr %0)
  ret i32 0
}

