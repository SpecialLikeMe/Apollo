; ModuleID = 'expr_then_decl'
source_filename = "expr_then_decl.apollo"

%apollo.aggregate.x = type { i32 }

define void @consume(ptr %value) {
entry:
  %value1 = alloca ptr, align 8
  store ptr %value, ptr %value1, align 8
  ret void
}

define i32 @main() {
entry:
  %x.object1 = alloca %apollo.aggregate.x, align 8
  %z = alloca ptr, align 8
  %x.object = alloca %apollo.aggregate.x, align 8
  store %apollo.aggregate.x zeroinitializer, ptr %x.object, align 4
  %0 = getelementptr inbounds nuw %apollo.aggregate.x, ptr %x.object, i32 0, i32 0
  store i32 3, ptr %0, align 4
  call void @consume(ptr %x.object)
  store %apollo.aggregate.x zeroinitializer, ptr %x.object1, align 4
  %1 = getelementptr inbounds nuw %apollo.aggregate.x, ptr %x.object1, i32 0, i32 0
  store i32 4, ptr %1, align 4
  store ptr %x.object1, ptr %z, align 8
  ret i32 0
}

