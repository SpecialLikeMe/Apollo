; ModuleID = 'soa_vector_surface'
source_filename = "soa_vector_surface.apollo"

%apollo.aggregate.Pair = type { i32, i32 }

define i32 @main() local_unnamed_addr {
entry:
  %loaded = alloca ptr, align 8
  %Pair.object1 = alloca %apollo.aggregate.Pair, align 8
  %second = alloca ptr, align 8
  %Pair.object = alloca %apollo.aggregate.Pair, align 8
  %first = alloca ptr, align 8
  %0 = tail call ptr @apollo_soa_vector_Pair_create()
  %.fca.1.gep = getelementptr inbounds nuw i8, ptr %Pair.object, i64 4
  store i32 1, ptr %Pair.object, align 8
  store i32 2, ptr %.fca.1.gep, align 4
  store ptr %Pair.object, ptr %first, align 8
  %.fca.1.gep9 = getelementptr inbounds nuw i8, ptr %Pair.object1, i64 4
  store i32 3, ptr %Pair.object1, align 8
  store i32 4, ptr %.fca.1.gep9, align 4
  store ptr %Pair.object1, ptr %second, align 8
  call void @apollo_soa_vector_Pair_push(ptr %0, ptr nonnull %first)
  call void @apollo_soa_vector_Pair_push(ptr %0, ptr nonnull %second)
  %1 = call ptr @apollo_soa_vector_Pair_get(ptr %0, i32 0)
  store ptr %1, ptr %loaded, align 8
  %2 = load i32, ptr %1, align 4
  %3 = getelementptr inbounds nuw i8, ptr %1, i64 4
  %4 = load i32, ptr %3, align 4
  %5 = add i32 %4, %2
  %6 = call i32 @apollo_soa_vector_Pair_size(ptr %0)
  %7 = icmp sgt i32 %6, 0
  br i1 %7, label %forin.body, label %forin.end

forin.body:                                       ; preds = %entry, %forin.body
  %entry.index.014 = phi i32 [ %11, %forin.body ], [ 0, %entry ]
  %total.013 = phi i32 [ %10, %forin.body ], [ %5, %entry ]
  %8 = call ptr @apollo_soa_vector_Pair_get(ptr %0, i32 %entry.index.014)
  %9 = load i32, ptr %8, align 4
  %10 = add i32 %9, %total.013
  %11 = add nuw nsw i32 %entry.index.014, 1
  %12 = call i32 @apollo_soa_vector_Pair_size(ptr %0)
  %13 = icmp slt i32 %11, %12
  br i1 %13, label %forin.body, label %forin.end

forin.end:                                        ; preds = %forin.body, %entry
  %total.0.lcssa = phi i32 [ %5, %entry ], [ %10, %forin.body ]
  call void @apollo_soa_vector_Pair_set(ptr %0, i32 1, ptr nonnull %loaded)
  ret i32 %total.0.lcssa
}

declare ptr @apollo_soa_vector_Pair_create() local_unnamed_addr

declare void @apollo_soa_vector_Pair_push(ptr, ptr) local_unnamed_addr

declare ptr @apollo_soa_vector_Pair_get(ptr, i32) local_unnamed_addr

declare i32 @apollo_soa_vector_Pair_size(ptr) local_unnamed_addr

declare void @apollo_soa_vector_Pair_set(ptr, i32, ptr) local_unnamed_addr

!apollo.backend = !{!0}
