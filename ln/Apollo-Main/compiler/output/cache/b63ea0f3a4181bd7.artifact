; ModuleID = 'status_file_surface'
source_filename = "status_file_surface.apollo"

@apollo.str.literal.1 = private unnamed_addr constant [2 x i8] c"w\00"
@apollo.str.literal.2 = private unnamed_addr constant [6 x i8] c"hello\00"
@apollo.str.literal.3 = private unnamed_addr constant [23 x i8] c"output/status_file.txt\00"
@apollo.file.open.mode = private unnamed_addr constant [2 x i8] c"r\00", align 1

define noalias noundef ptr @write_log() local_unnamed_addr {
entry:
  %0 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.str.literal.1)
  %1 = tail call i32 @sys__native_file_write(ptr %0, ptr nonnull @apollo.str.literal.2)
  %2 = tail call i32 @sys__native_file_close(ptr %0)
  ret ptr null
}

define noalias noundef ptr @read_log() local_unnamed_addr {
entry:
  %0 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.file.open.mode)
  %1 = tail call ptr @sys__native_file_read_all(ptr %0)
  %2 = tail call i32 @sys__native_file_close(ptr %0)
  %puts = tail call i32 @puts(ptr nonnull dereferenceable(1) %1)
  ret ptr null
}

define noalias noundef ptr @run() local_unnamed_addr {
entry:
  %0 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.str.literal.1)
  %1 = tail call i32 @sys__native_file_write(ptr %0, ptr nonnull @apollo.str.literal.2)
  %2 = tail call i32 @sys__native_file_close(ptr %0)
  %3 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.file.open.mode)
  %4 = tail call ptr @sys__native_file_read_all(ptr %3)
  %5 = tail call i32 @sys__native_file_close(ptr %3)
  %puts.i = tail call i32 @puts(ptr nonnull dereferenceable(1) %4)
  ret ptr null
}

define noundef i32 @main() local_unnamed_addr {
entry:
  %0 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.str.literal.1)
  %1 = tail call i32 @sys__native_file_write(ptr %0, ptr nonnull @apollo.str.literal.2)
  %2 = tail call i32 @sys__native_file_close(ptr %0)
  %3 = tail call ptr @fopen(ptr nonnull @apollo.str.literal.3, ptr nonnull @apollo.file.open.mode)
  %4 = tail call ptr @sys__native_file_read_all(ptr %3)
  %5 = tail call i32 @sys__native_file_close(ptr %3)
  %puts.i.i = tail call i32 @puts(ptr nonnull dereferenceable(1) %4)
  ret i32 0
}

