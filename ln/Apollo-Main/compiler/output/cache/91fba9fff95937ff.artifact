; ModuleID = 'typedef_opstruct_recursive_matcher'
source_filename = "typedef_opstruct_recursive_matcher.apollo"

define noundef i32 @main() local_unnamed_addr {
entry:
  %0 = tail call dereferenceable_or_null(64) ptr @malloc(i64 64)
  br label %stdin.read.outer.i

stdin.read.outer.i:                               ; preds = %stdin.append.i, %entry
  %stdin.started.0.ph.i = phi i1 [ true, %stdin.append.i ], [ false, %entry ]
  %stdin.length.0.ph.i = phi i64 [ %13, %stdin.append.i ], [ 0, %entry ]
  %stdin.capacity1.0.ph.i = phi i64 [ %stdin.capacity1.1.i, %stdin.append.i ], [ 64, %entry ]
  %stdin.buffer.0.ph.i = phi ptr [ %stdin.buffer.1.i, %stdin.append.i ], [ %0, %entry ]
  br i1 %stdin.started.0.ph.i, label %stdin.read.outer.split.us.i, label %stdin.read.i

stdin.read.outer.split.us.i:                      ; preds = %stdin.read.outer.i
  %1 = tail call i32 @getchar()
  %2 = icmp eq i32 %1, -1
  br i1 %2, label %apollo_stdin_read_line.exit, label %stdin.start.i

stdin.read.i:                                     ; preds = %stdin.read.outer.i, %stdin.read.i.backedge
  %3 = tail call i32 @getchar()
  switch i32 %3, label %stdin.start.i [
    i32 -1, label %apollo_stdin_read_line.exit
    i32 32, label %stdin.read.i.backedge
    i32 13, label %stdin.read.i.backedge
    i32 12, label %stdin.read.i.backedge
    i32 11, label %stdin.read.i.backedge
    i32 10, label %stdin.read.i.backedge
    i32 9, label %stdin.read.i.backedge
  ]

stdin.read.i.backedge:                            ; preds = %stdin.read.i, %stdin.read.i, %stdin.read.i, %stdin.read.i, %stdin.read.i, %stdin.read.i
  br label %stdin.read.i

stdin.start.i:                                    ; preds = %stdin.read.i, %stdin.read.outer.split.us.i
  %.us-phi17.i = phi i32 [ %1, %stdin.read.outer.split.us.i ], [ %3, %stdin.read.i ]
  %4 = icmp eq i32 %.us-phi17.i, 10
  %5 = icmp eq i32 %.us-phi17.i, 13
  %6 = or i1 %4, %5
  %7 = and i1 %stdin.started.0.ph.i, %6
  br i1 %7, label %apollo_stdin_read_line.exit, label %stdin.capacity.i

stdin.capacity.i:                                 ; preds = %stdin.start.i
  %8 = add i64 %stdin.capacity1.0.ph.i, -1
  %.not.i = icmp ult i64 %stdin.length.0.ph.i, %8
  br i1 %.not.i, label %stdin.append.i, label %stdin.grow.i

stdin.grow.i:                                     ; preds = %stdin.capacity.i
  %9 = shl i64 %stdin.capacity1.0.ph.i, 1
  %10 = tail call ptr @realloc(ptr %stdin.buffer.0.ph.i, i64 %9)
  br label %stdin.append.i

stdin.append.i:                                   ; preds = %stdin.grow.i, %stdin.capacity.i
  %stdin.capacity1.1.i = phi i64 [ %9, %stdin.grow.i ], [ %stdin.capacity1.0.ph.i, %stdin.capacity.i ]
  %stdin.buffer.1.i = phi ptr [ %10, %stdin.grow.i ], [ %stdin.buffer.0.ph.i, %stdin.capacity.i ]
  %11 = getelementptr inbounds i8, ptr %stdin.buffer.1.i, i64 %stdin.length.0.ph.i
  %12 = trunc i32 %.us-phi17.i to i8
  store i8 %12, ptr %11, align 1
  %13 = add i64 %stdin.length.0.ph.i, 1
  br label %stdin.read.outer.i

apollo_stdin_read_line.exit:                      ; preds = %stdin.read.outer.split.us.i, %stdin.start.i, %stdin.read.i
  %14 = getelementptr inbounds i8, ptr %stdin.buffer.0.ph.i, i64 %stdin.length.0.ph.i
  store i8 0, ptr %14, align 1
  %15 = tail call i32 @apollo_execute_apollo_payload(ptr %stdin.buffer.0.ph.i)
  ret i32 0
}

