#[gcmode(total)]

struct Box {
    public i32 value;

    public i32 bump() {
        return value + 1;
    }
}

global Box shared = Box{};

int main() {
    Box local = Box{};
    ato inferred = Box{};
    stat direct = Box{};

    local.bump();
    inferred.bump();
    direct.bump();
    shared.bump();

    return 0;
}