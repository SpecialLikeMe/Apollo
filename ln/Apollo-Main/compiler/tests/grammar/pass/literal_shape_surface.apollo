bool invert(bool value) {
    if (value) {
        return false;
    }
    return true;
}

char first_codepoint() {
    return 'a';
}

byte first_byte() {
    return b'a';
}

usize handle_id(usize value) {
    return value;
}

f64 circle_ratio() {
    return 3.14159;
}

str none_value() {
    return null;
}

{char, bool} literal_bundle() {
    return {'z', true};
}

i32 main() {
    if (invert(false)) {
        return 1;
    }
    return 0;
}