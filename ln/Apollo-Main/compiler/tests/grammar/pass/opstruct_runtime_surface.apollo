#[fallback(allow)]
#[macro_mode(runtime)]

stdef opstruct Packet {
    str name;
    i32 size;
}

typedef opstruct Packet PacketAlias;

typedef opstruct cool {
    asg("cool ${name}") -> {
    }

    src("please do ${DO}") -> {
        DO
    }
}

extern [&dynamic_macro] log_packet(Packet packet) {
    sys.println(packet.name);
}

int main() {
    nconst PacketAlias packet = PacketAlias{};
    log_packet(packet);
    cool mycool
    please do [sys.stdin()];
    return 0;
}