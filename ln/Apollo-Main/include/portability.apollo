namespace sys {
    i32 host_is_windows() {
        return sys__native_host_is_windows();
    }

    str path_separator() {
        return sys__native_path_separator();
    }

    str exe_suffix() {
        return sys__native_exe_suffix();
    }

    str env_get(nconst str& key) {
        return sys__native_env_get(key);
    }

    i32 env_set(nconst str& key, nconst str& value) {
        return sys__native_env_set(key, value);
    }

    i32 env_remove(nconst str& key) {
        return sys__native_env_remove(key);
    }

    str current_dir() {
        return sys__native_current_dir();
    }

    i32 set_current_dir(nconst str& path) {
        return sys__native_set_current_dir(path);
    }

    str executable_path() {
        return sys__native_executable_path();
    }

    i32 process_id() {
        return sys__native_process_id();
    }

    i32 cpu_count() {
        return sys__native_cpu_count();
    }

    str host_name() {
        return sys__native_host_name();
    }

    str temp_dir() {
        return sys__native_temp_dir();
    }

    str path_join(nconst str& left, nconst str& right) {
        return sys__native_path_join(left, right);
    }

    void sleep_ms(i32 value) {
        sys__native_sleep_ms(value);
    }
}

