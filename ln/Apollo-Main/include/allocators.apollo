namespace sys {
    DefaultAllocator alloc_default() {
        DefaultAllocator allocator = {
            .label = "default",
            .strategy = "general",
            .default_block_bytes = 4096,
            .thread_safe = true,
            .relocatable = true,
            .last_type = "",
            .allocation_count = 0,
            .release_count = 0,
            .reserved_bytes = 0,
            .peak_bytes = 0
        };
        return allocator;
    }

