memstruct DefaultAllocator {
    str label;
    str strategy;
    i32 default_block_bytes;
    bool thread_safe;
    bool relocatable;
    str last_type;
    i32 allocation_count;
    i32 release_count;
    i32 reserved_bytes;
    i32 peak_bytes;

    public i32 alloc(str type_name, i32 requested_bytes) {
        last_type = type_name;
        allocation_count = allocation_count + 1;
        reserved_bytes = reserved_bytes + requested_bytes;
        if (reserved_bytes > peak_bytes) {
            peak_bytes = reserved_bytes;
        }
        return requested_bytes;
    }

    public i32 resize(str type_name, i32 previous_bytes, i32 requested_bytes) {
        last_type = type_name;
        reserved_bytes = reserved_bytes - previous_bytes + requested_bytes;
        if (reserved_bytes < 0) {
            reserved_bytes = 0;
        }
        if (reserved_bytes > peak_bytes) {
            peak_bytes = reserved_bytes;
        }
        return requested_bytes;
    }

    public i32 remap(str type_name, i32 previous_bytes, i32 requested_bytes) {
        return resize(type_name, previous_bytes, requested_bytes);
    }

    public i32 free(str type_name, i32 released_bytes) {
        last_type = type_name;
        release_count = release_count + 1;
        reserved_bytes = reserved_bytes - released_bytes;
        if (reserved_bytes < 0) {
            reserved_bytes = 0;
        }
        return reserved_bytes;
    }
}

