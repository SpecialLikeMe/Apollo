// This should fail: owner-managed bindings cannot be passed to callees that store them in globals.

class Box {
}

global Box saved;

void save(Box value) {
    saved = value;
    return;
}

i32 main() {
    Box value = Box{};

    @autofmtdeclare {
        @induct value;
        save(value);
    }

    return 0;
}
