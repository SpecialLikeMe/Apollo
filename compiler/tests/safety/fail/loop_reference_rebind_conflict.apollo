// This should fail: a reference rebound inside a loop cannot be used after the loop if the origin may differ.

void touch(nconst i32& value) {
    sys.println(value);
    return;
}

int main() {
    nconst i32 first = 1;
    nconst i32 second = 2;
    i32 loop = 1;
    nconst i32& alias = &nconst first;
    while (loop) {
        alias = &nconst second;
        loop = 0;
    }
    touch(alias);
    return first + second;
}