#[setting(scheduler, eevf)]

@cmglobal struct SharedState.att{packed} {
    i32 mask;
}

i32 decorate(i32 value).att{aligned(16)} {
    i32 shifted = value << 1;
    i32 mixed = shifted | 3;
    i32 toggled = mixed ^ 2;
    return toggled & 7;
}

int main() {
    SharedState state = SharedState{};
    return decorate(4);
}