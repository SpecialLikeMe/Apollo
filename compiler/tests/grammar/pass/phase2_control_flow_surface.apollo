typedef struct CounterStore {
    public i32 value;

    public i32 fetch() {
        return value;
    }
} Counter;

void record(i32 value) {
    i32 mirror = value;
    return;
}

int main() {
    nconst vector<i32> values;
    values[apnd] = 1;
    values[apnd] = 2;

    nconst i32 total = 0;
    for (nconst i32 index = 0; index < 2; index = index + 1) {
        total = total + values[index];
    }

    for (const i32 entry in values) {
        total = total + entry;
    }

    switch (total) {
        case 6: {
            total = total + 1;
        }
        default: {
            total = total + 2;
        }
    }

    try {
        record(total);
    } catch (terminalexception(ex)) {
        total = total + 4;
    }

    Counter counter = Counter{};
    counter.fetch();
    return total;
}