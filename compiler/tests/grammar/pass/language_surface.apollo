extern iostream;
extern vector;
extern "array";

extern [&macro] announce(str message) {
    sys.println(message);
}

global i32 globalCounter = 1;
i32 plainGlobal = 2;

template Box(T) {
    public T fetch(T value) {
        return value;
    }
}

itr Speaker {
    virtual void speak();
}

itr Walker {
    virtual void walk();
}

struct Pair {
    public i32 left;
    public i32 right;

    public i32 sum() {
        return left + right;
    }
}

class Animal * public Speaker; public Walker {
    public i32 value;

    public virtual void speak() {
        sys.println("animal");
        return;
    }

    public virtual void walk() {
        sys.println("walk");
        return;
    }
}

class Dog * public Animal {
    public static void tag() {
        sys.println("dog-tag");
        return;
    }

    @Override
    public void speak() {
        sys.println("dog");
        return;
    }

    @Override
    public void walk() {
        sys.println("dog-walk");
        return;
    }
}

i32 plusOne(nconst i32 value) {
    if (value < 10) {
        value = value + 1;
    } else {
        value = value - 1;
    }
    return value;
}

str& keep(str& value) {
    return value;
}

void ping() {
    return;
}

int main() {
    nconst Box<int> box;
    nconst i32 local = plusOne(globalCounter);
    i32 narrowed = (i32)local;
    str templ = `hello template`;
    fn<i32(i32, i32)> add = lmd-> (i32 left, i32 right) {
        return left + right;
    }
    fn<i32(i32)> promote = lmd-> i32 named(i32 input) {
        return input;
    }
    i32 sum = add(1, 2);
    i32 promoted = promote(sum);
    nconst vector<str> names;
    names[apnd] = templ;
    nconst hsh<str, i32> scores;
    scores["dog"] = promoted;
    nconst hsh<hsh<i32, str>, hsh<str, i32>> nested;
    nested[<23, "hello">] = <"world", 9>;
    sys.println(nested[<23, "hello">]["world"]);
    crt instance pack;
    pack.push(Dog{});
    pack.speak();
    staticx instance direct = Dog{};
    direct.speak();
    Dog.tag();
    @unsafe {
        Dog* dogPtr _&direct;
        dogPtr.speak();
    }
    direct.value;
    Pair point = Pair{};
    point.sum();
    nconst str input;
    sys.stdin(input);
    {
        box.fetch(local);
        i32 scoped = local;
        sys.println(scoped);
    }
    while (local < 3) {
        local = local + 1;
    }
    str borrowed = keep(templ);
    announce(borrowed);
    sys.stdout(scores["dog"]);
    return plainGlobal + narrowed;
}