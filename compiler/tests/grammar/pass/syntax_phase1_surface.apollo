extern iostream;

__preprocess [&macro] check(u32 value) {
    assert(value > 0);
}

u32 pick(u32 left, u32 right, const i32 chooseLeft) {
    assert(chooseLeft == 0 || chooseLeft == 1);
    return chooseLeft == 1 ? left : right;
}

int main() {
    i16 signedSmall = 3;
    u16 small = 7;
    u32 selected = pick(1, 2, 1);
    u64 widened = selected == 1 ? 9 : 11;
    check(selected);
    sys.println(selected == 1 ? widened : small);
    return signedSmall;
}