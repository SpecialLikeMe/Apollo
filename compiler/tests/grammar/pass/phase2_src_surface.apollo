int main() {
    src greet = {
        sys.println("hello");
    }

    src echo(str value) -> str = {
        return value;
    }

    nconst src count(i32 value) -> i32 = {
        return value + 1;
    }

    greet();
    ato echoed = echo("world");
    nconst total := count(4);
    total = total + 1;
    sys.println(echoed);
    return total;
}